# Brownstone Dredging & Infrastructure — static export config for Apache/LiteSpeed

# Serve the custom 404 page
ErrorDocument 404 /404.html

# Force HTTPS — ENABLE THIS ONLY AFTER your SSL certificate is active in
# hPanel (Security > SSL). Uncomment the block below, then re-upload this file.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Caching policy
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML must NOT be cached, so content updates appear immediately
  ExpiresByType text/html "access plus 0 seconds"
  # Build assets have content-hashed names, so cache them long
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Images cached moderately (swappable without new filenames)
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresDefault "access plus 1 hour"
</IfModule>

# Explicitly prevent HTML caching (belt and suspenders)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
